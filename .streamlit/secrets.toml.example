# ==============================================================================
# finance_v1 - Streamlit Secrets Example (1인 1세트 설정)
# 로컬 실행 시 이 파일을 .streamlit/secrets.toml 로 복사하여 사용하세요.
# Streamlit Cloud 배포 시 App Settings -> Secrets 에 그대로 붙여넣으세요.
# ==============================================================================

# 사용자 식별자 (data/<USER_ID>/ 캐시 분리 및 화면 표시용)
USER_ID = "user_a"

# 선택: 단독 사용 시 로그인 보호 설정 (Google Cloud Console OAuth 불필요)
# 둘 다 비워두면 로그인 화면 없이 바로 접속합니다.
ALLOWED_EMAIL = ""
APP_PASSWORD = ""  # 평문 또는 "sha256:<해시값>" 형식 지원

# ==============================================================================
# 선택: 여러 사용자가 각자 아이디/비밀번호로 구분 접속할 경우 [users.<아이디>] 사용
# (아래 섹션을 활성화하면 로그인 화면에서 아이디/비밀번호로 사용자를 구분하며,
#  각 사용자의 SHEET_ID, KIS 키, 캐시 디렉토리가 완전히 분리됩니다.)
# ==============================================================================
# [users.user_a]
# password = "user_a_password"
# ALLOWED_EMAIL = "user_a@example.com"  # 선택: 이메일로도 로그인 허용
# SHEET_ID = "1abc..._user_a_sheet_id"
# KIS_APP_KEY = "PS..."
# KIS_APP_SECRET = "..."
# KIS_ACCOUNT_NO = "12345678-01"
# IS_MOCK = true
#
# [users.user_b]
# password = "user_b_password"
# SHEET_ID = "1xyz..._user_b_sheet_id"
# KIS_APP_KEY = "PS..."
# KIS_APP_SECRET = "..."
# KIS_ACCOUNT_NO = "87654321-01"
# IS_MOCK = false

# 개인 전용 Google Spreadsheet ID (본인 시트에 아래 서비스 계정 이메일을 편집자로 공유)
SHEET_ID = "1abc..._your_personal_spreadsheet_id"

# 한국투자증권(KIS) API 자격증명
KIS_APP_KEY = "PS..."
KIS_APP_SECRET = "..."
KIS_ACCOUNT_NO = "12345678-01"
IS_MOCK = true  # true: 모의투자(VTS), false: 실전투자(REAL)

# 텔레그램 알림 설정 (선택)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""

# Google Cloud 서비스 계정 JSON 정보
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "kis-trader@your-gcp-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
